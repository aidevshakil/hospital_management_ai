# Copy this file to `.env` at the project root and fill in real values.
#   cp .env.example .env
# `.env` is gitignored. next.config.ts, prisma.config.ts and prisma/seed.ts all
# load it via dotenv, so the same file serves the app and the Prisma CLI.

# --- Required -------------------------------------------------------------
# PostgreSQL connection string used by Prisma (@prisma/adapter-pg).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hospital_management"

# Secret used to sign session cookies.
SESSION_SECRET=""

# Powers the AI Health Assistant (/ai-checker). Without it the chat endpoint
# returns 503 and the widget shows a "not configured" message.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# Optional — defaults to llama-3.3-70b-versatile. Groq retires model IDs
# periodically; override here if the default stops working.
GROQ_MODEL=""

# --- Email (appointment confirmations / reminders) ------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# --- Reminder cron job ----------------------------------------------------
# Shared secret required by the reminder route handler.
CRON_SECRET=""
# How far ahead to look for appointments needing a reminder.
REMINDER_WINDOW_HOURS="24"
